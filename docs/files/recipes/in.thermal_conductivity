# =====================================================================
# Thermal conductivity of an LJ liquid, Muller-Plathe method
# (fix thermal/conductivity swaps kinetic energy between a hot and a cold
# slab; the steady temperature gradient gives kappa = |flux / (dT/dz)|).
# NTRG lab recipe. lj units. Same idea works for solids, e.g. Cu with EAM
# (but classical MD only gives the phonon part; metals conduct mostly by
# electrons, which MD doesn't include).
# Run:    mpirun -n 4 lmp -in in.thermal_conductivity -log log.lammps
# Quick:  -var neq 2000 -var nprod 5000
# Output: temp_profile.dat; the log prints the fit_profile.py command that gives kappa
# =====================================================================
variable        neq   index 20000
variable        nprod index 200000
variable        T     index 1.35
variable        rho   index 0.6

units           lj
atom_style      atomic
lattice         fcc ${rho}
region          box block 0 6 0 6 0 24
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin

velocity        all create ${T} 87287 mom yes rot yes dist gaussian
timestep        0.007
fix             nvt all nvt temp ${T} ${T} 0.5
thermo          1000
run             ${neq}
unfix           nvt

reset_timestep  0
fix             nve all nve
compute         ke all ke/atom
variable        temp atom c_ke/1.5
compute         layers all chunk/atom bin/1d z lower 0.05 units reduced
fix             prof all ave/chunk 100 $(v_nprod/100) ${nprod} layers v_temp file temp_profile.dat
fix             mp all thermal/conductivity 100 z 20          # defined after ave/chunk

variable        area equal lx*ly
variable        flux equal f_mp/(2*v_area*step*dt+1e-30)
thermo_style    custom step temp etotal f_mp v_flux
run             ${nprod}
print           "Heat flux = ${flux}"
print           "Next: python3 fit_profile.py temp_profile.dat --flux ${flux} --column v_temp --length $(lz)"
print           "=== DONE ==="

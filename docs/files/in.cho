# ReaxFF C/H/O example: adapted from LAMMPS stable_29Sep2021 examples/reaxff/CHO
# 105 atoms, held at 500 K, 3000 steps x 0.25 fs = 0.75 ps
# Needs: data.CHO and ffield.reax.cho in the same folder (see README.md)

units           real
atom_style      charge
read_data       data.CHO

pair_style      reaxff NULL
pair_coeff      * * ffield.reax.cho H C O     # order must match atom types: 1=H 2=C 3=O

neighbor        2 bin
neigh_modify    every 10 delay 0 check no

fix             1 all nve
fix             2 all qeq/reaxff 1 0.0 10.0 1e-6 reaxff
fix             3 all temp/berendsen 500.0 500.0 100.0

timestep        0.25
thermo          100
thermo_style    custom step time temp pe press
dump            1 all custom 30 traj.lammpstrj id type q x y z

run             3000
print           "=== DONE ==="

# Small Cu test: ~4,000 atoms, FCC, held at 300 K / 0 bar for 50 ps
# Needs: Cu_mishin1.eam.alloy in the same folder (see docs/03-potentials.md)

units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 3.615
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

pair_style      eam/alloy
pair_coeff      * * Cu_mishin1.eam.alloy Cu

velocity        all create 300 482917 mom yes rot yes
fix             1 all npt temp 300 300 0.1 iso 0 0 1.0
timestep        0.001

thermo          1000
thermo_style    custom step time temp press pe vol density
dump            1 all custom 5000 traj.lammpstrj id type x y z

run             50000
print           "=== DONE ==="
